rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId}/segments/{segId} {
      allow read: if true; // 変更: 誰でも読み取り可能に
      allow write: if false;
    }

    match /rooms/{roomId}/meta/{docId} {
      allow read: if true; // 変更: 誰でも読み取り可能に
      allow write: if false;
    }
  }
}